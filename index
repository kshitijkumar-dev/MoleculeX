<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>MOLECULEX — Artificial Intelligence in Drug Discovery</title>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@600;700&family=Space+Mono:ital,wght@0,400;0,700;1,400&family=Outfit:wght@300;400;600;800&display=swap" rel="stylesheet"/>
<style>
  :root {
    --bg: #04201f;
    --surface: #07302d;
    --card: #0b3a36;
    --border: #14574f;
    --accent: #2dd4bf;
    --accent2: #fb7185;
    --accent3: #34d399;
    --warn: #f59e0b;
    --text: #e2e8f0;
    --muted: #8fb5b0;
    --mono: 'Space Mono', monospace;
    --serif: 'Fraunces', Georgia, serif;
    --sans: 'Outfit', sans-serif;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--sans);
    overflow-x: hidden;
    scroll-behavior: smooth;
  }

  /* ── STARFIELD ── */
  #starfield {
    position: fixed; inset: 0; z-index: 0; pointer-events: none;
  }

  /* ── NAV ── */
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    background: rgba(4,32,31,0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    padding: 0 2rem;
    display: flex; align-items: center; justify-content: space-between;
    height: 60px;
  }
  .nav-logo {
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--accent);
    letter-spacing: 0.05em;
  }
  .nav-links { display: flex; gap: 1.5rem; list-style: none; }
  .nav-links a {
    font-size: 0.8rem;
    color: var(--muted);
    text-decoration: none;
    font-family: var(--mono);
    transition: color 0.2s;
    letter-spacing: 0.03em;
  }
  .nav-links a:hover { color: var(--accent); }

  /* ── HERO ── */
  .hero {
    position: relative; z-index: 1;
    min-height: 100vh;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    text-align: center;
    padding: 6rem 2rem 4rem;
  }
  .hero-badge {
    display: inline-flex; align-items: center; gap: 0.5rem;
    background: rgba(45,212,191,0.08);
    border: 1px solid rgba(45,212,191,0.25);
    border-radius: 999px;
    padding: 0.35rem 1rem;
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--accent);
    letter-spacing: 0.08em;
    margin-bottom: 2rem;
    animation: fadeUp 0.6s ease both;
  }
  .hero-badge::before { content: '◉'; animation: pulse 2s infinite; }
  @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.3} }

  .hero h1 {
    font-size: clamp(2.2rem, 6vw, 5rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-bottom: 1.5rem;
    animation: fadeUp 0.6s 0.1s ease both;
  }
  .hero h1 span { color: var(--accent); }
  .hero h1 em { color: var(--accent2); font-style: normal; }

  .hero-sub {
    max-width: 600px;
    font-size: 1.05rem;
    color: var(--muted);
    line-height: 1.7;
    margin-bottom: 2.5rem;
    animation: fadeUp 0.6s 0.2s ease both;
  }

  .hero-pills {
    display: flex; flex-wrap: wrap; gap: 0.6rem;
    justify-content: center;
    animation: fadeUp 0.6s 0.3s ease both;
    margin-bottom: 3rem;
  }
  .pill {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.4rem 1rem;
    font-size: 0.78rem;
    font-family: var(--mono);
    color: var(--text);
  }

  .hero-scroll {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--muted);
    letter-spacing: 0.1em;
    animation: fadeUp 0.6s 0.5s ease both, bounce 2s 1.5s infinite;
  }
  @keyframes bounce { 0%,100%{transform:translateY(0)} 50%{transform:translateY(6px)} }
  @keyframes fadeUp { from{opacity:0;transform:translateY(20px)} to{opacity:1;transform:translateY(0)} }

  /* ── MOLECULE CANVAS ── */
  #mol-canvas {
    position: absolute;
    top: 50%; right: 6%;
    transform: translateY(-50%);
    width: min(380px, 38vw);
    height: min(380px, 38vw);
    opacity: 0.9;
  }
  @media(max-width:768px){ #mol-canvas { display: none; } }

  /* ── SECTIONS ── */
  section {
    position: relative; z-index: 1;
    padding: 5rem 2rem;
    max-width: 1100px;
    margin: 0 auto;
  }
  .section-label {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--accent);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 0.6rem;
  }
  .section-title {
    font-size: clamp(1.6rem, 3.5vw, 2.6rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }
  .section-desc {
    color: var(--muted);
    max-width: 600px;
    line-height: 1.7;
    margin-bottom: 3rem;
    font-size: 0.95rem;
  }

  /* ── CARDS ── */
  .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.8rem;
    transition: border-color 0.3s, transform 0.3s;
  }
  .card:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
  }
  .card-grid { display: grid; grid-template-columns: repeat(auto-fill,minmax(300px,1fr)); gap: 1.5rem; }

  /* ── DOCKING TOOL ── */
  .tool-wrapper {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 20px;
    overflow: hidden;
  }
  .tool-header {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    padding: 1rem 1.5rem;
    display: flex; align-items: center; gap: 0.6rem;
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--muted);
  }
  .dot { width:10px; height:10px; border-radius:50%; }
  .dot-r{background:#ff5f57;} .dot-y{background:#febc2e;} .dot-g{background:#28c840;}

  .tool-body { padding: 1.8rem; }

  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem; }
  @media(max-width:600px){ .form-row { grid-template-columns: 1fr; } }

  label { font-size: 0.75rem; font-family: var(--mono); color: var(--muted); display: block; margin-bottom: 0.4rem; letter-spacing: 0.05em; }
  select, input[type=text], input[type=range] {
    width: 100%;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text);
    font-family: var(--mono);
    font-size: 0.82rem;
    padding: 0.65rem 0.9rem;
    outline: none;
    transition: border-color 0.2s;
    -webkit-appearance: none;
  }
  select:focus, input:focus { border-color: var(--accent); }
  select option { background: var(--card); }

  input[type=range] {
    padding: 0;
    cursor: pointer;
    accent-color: var(--accent);
    height: 4px;
    border: none;
  }

  .btn {
    display: inline-flex; align-items: center; gap: 0.5rem;
    background: var(--accent);
    color: var(--bg);
    border: none; border-radius: 10px;
    padding: 0.75rem 1.6rem;
    font-family: var(--mono);
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
    transition: opacity 0.2s, transform 0.15s;
    letter-spacing: 0.03em;
  }
  .btn:hover { opacity: 0.85; transform: scale(1.02); }
  .btn:disabled { opacity: 0.4; cursor: default; transform: none; }
  .btn-purple { background: var(--accent2); color: #fff; }
  .btn-green { background: var(--accent3); color: #fff; }

  /* result panel */
  .result-panel {
    margin-top: 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.2rem 1.5rem;
    display: none;
  }
  .result-panel.show { display: block; animation: fadeUp 0.4s ease; }
  .result-title { font-family: var(--mono); font-size: 0.7rem; color: var(--muted); letter-spacing: 0.1em; margin-bottom: 1rem; }
  .metric-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.6rem; }
  .metric-label { font-size: 0.82rem; color: var(--muted); }
  .metric-value { font-family: var(--mono); font-size: 0.88rem; font-weight: 700; }
  .good { color: var(--accent3); }
  .ok   { color: var(--warn); }
  .bad  { color: #f87171; }

  .score-bar-wrap { margin: 1rem 0; }
  .score-bar-bg { background: var(--border); border-radius: 999px; height: 6px; overflow: hidden; }
  .score-bar-fill { height: 100%; border-radius: 999px; transition: width 1s ease; }

  /* ── ADMET ── */
  .admet-grid {
    display: grid; grid-template-columns: repeat(auto-fill,minmax(160px,1fr)); gap: 1rem;
    margin-top: 1.5rem;
  }
  .admet-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1rem;
    text-align: center;
  }
  .admet-icon { font-size: 1.8rem; margin-bottom: 0.4rem; }
  .admet-name { font-family: var(--mono); font-size: 0.65rem; color: var(--muted); letter-spacing: 0.08em; margin-bottom: 0.3rem; }
  .admet-val { font-weight: 700; font-size: 0.95rem; }

  /* ── AI CHAT ── */
  .chat-wrap {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 20px;
    overflow: hidden;
  }
  .chat-messages {
    min-height: 260px;
    max-height: 400px;
    overflow-y: auto;
    padding: 1.5rem;
    display: flex; flex-direction: column; gap: 1rem;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
  }
  .msg {
    display: flex; gap: 0.8rem; align-items: flex-start;
    animation: fadeUp 0.3s ease;
  }
  .msg-avatar {
    width: 32px; height: 32px; flex-shrink: 0;
    border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    font-size: 0.9rem;
    font-weight: 700;
  }
  .msg-avatar.user { background: rgba(251,113,133,0.25); color: var(--accent2); border: 1px solid rgba(251,113,133,0.3); }
  .msg-avatar.ai   { background: rgba(45,212,191,0.15); color: var(--accent); border: 1px solid rgba(45,212,191,0.25); }
  .msg-bubble {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 0.75rem 1rem;
    font-size: 0.88rem;
    line-height: 1.65;
    max-width: 85%;
    white-space: pre-wrap;
  }
  .msg-bubble.ai-bubble { border-color: rgba(45,212,191,0.2); }

  .chat-input-row {
    display: flex; gap: 0.7rem;
    padding: 1rem 1.5rem;
    border-top: 1px solid var(--border);
    background: var(--surface);
  }
  .chat-input {
    flex: 1;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
    color: var(--text);
    font-family: var(--sans);
    font-size: 0.88rem;
    padding: 0.65rem 1rem;
    outline: none;
    resize: none;
    line-height: 1.5;
  }
  .chat-input:focus { border-color: var(--accent); }

  /* typing indicator */
  .typing { display: flex; gap: 4px; align-items: center; padding: 0.6rem; }
  .typing span { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); opacity: 0.4; animation: blink 1.2s infinite; }
  .typing span:nth-child(2){ animation-delay:0.2s; }
  .typing span:nth-child(3){ animation-delay:0.4s; }
  @keyframes blink { 0%,80%,100%{opacity:0.4} 40%{opacity:1} }

  /* ── PIPELINE DIAGRAM ── */
  .pipeline {
    display: flex; align-items: flex-start; gap: 0;
    overflow-x: auto; padding-bottom: 1rem;
  }
  .pipe-step {
    flex: 1; min-width: 130px;
    display: flex; flex-direction: column; align-items: center;
    text-align: center;
  }
  .pipe-icon {
    width: 56px; height: 56px;
    border-radius: 16px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.5rem;
    margin-bottom: 0.7rem;
    border: 1px solid var(--border);
    position: relative;
    z-index: 1;
  }
  .pipe-step:not(:last-child)::after {
    content: '';
    position: absolute;
    /* handled via JS connector */
  }
  .pipe-connector {
    flex: 0 0 30px;
    height: 56px;
    display: flex; align-items: center; justify-content: center;
    color: var(--border);
    font-size: 1.2rem;
    padding-top: 0;
  }
  .pipe-name { font-family: var(--mono); font-size: 0.68rem; color: var(--muted); letter-spacing: 0.05em; line-height: 1.4; }

  /* ── CONCEPTS ── */
  .concept-icon { font-size: 2rem; margin-bottom: 0.8rem; }
  .card h3 { font-size: 1rem; font-weight: 700; margin-bottom: 0.5rem; }
  .card p { font-size: 0.85rem; color: var(--muted); line-height: 1.6; }

  /* ── FOOTER ── */
  footer {
    position: relative; z-index: 1;
    border-top: 1px solid var(--border);
    padding: 2rem;
    text-align: center;
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--muted);
  }

  /* ── GLOW ── */
  .glow-blob {
    position: fixed; pointer-events: none; z-index: 0;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.18;
  }

  /* loader spinner */
  .spinner {
    display: inline-block;
    width: 14px; height: 14px;
    border: 2px solid rgba(255,255,255,0.2);
    border-top-color: currentColor;
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
    vertical-align: middle;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* ── SCROLL REVEAL ── */
  .reveal { opacity: 0; transform: translateY(24px); transition: opacity 0.6s ease, transform 0.6s ease; }
  .reveal.visible { opacity: 1; transform: none; }

  /* warning box */
  .warn-box {
    background: rgba(245,158,11,0.08);
    border: 1px solid rgba(245,158,11,0.3);
    border-radius: 10px;
    padding: 0.7rem 1rem;
    font-size: 0.78rem;
    color: var(--warn);
    font-family: var(--mono);
    margin-bottom: 1rem;
  }

  /* range value display */
  .range-row { display: flex; align-items: center; gap: 0.8rem; }
  .range-val { font-family: var(--mono); font-size: 0.8rem; color: var(--accent); min-width: 40px; text-align: right; }

  .hero h1, .section-title { font-family: var(--serif); font-weight: 700; }
  .btn-purple { color:#04201f; }
  .nav-links { gap: 1.1rem; }
  @media(max-width:1000px){ .nav-links{display:none;} }
  .team-row { margin-top:1.2rem; font-family:var(--mono); font-size:0.72rem; color:var(--muted); line-height:1.8; animation: fadeUp 0.6s 0.4s ease both; }
  .big-stats { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:1.5rem; margin-bottom:1.5rem; }
  .big-num { font-family:var(--serif); font-size:3.2rem; font-weight:700; line-height:1; }
  .big-num.teal{color:var(--accent);} .big-num.rose{color:var(--accent2);}
  .big-cap { color:var(--muted); font-size:0.85rem; margin-top:0.4rem; }
  .src { font-family:var(--mono); font-size:0.65rem; color:var(--accent); margin-top:0.8rem; }
  /* pipeline explorer */
  .pipe-step { cursor:pointer; }
  .pipe-step:hover .pipe-icon, .pipe-step.active .pipe-icon { border-color:var(--accent); box-shadow:0 0 0 3px rgba(45,212,191,0.2); }
  .pipe-step.active .pipe-name { color:var(--accent); }
  .pipe-detail { margin-top:1.5rem; background:var(--surface); border:1px solid var(--border); border-radius:12px; padding:1.2rem 1.5rem; font-size:0.88rem; line-height:1.7; color:var(--muted); }
  .pipe-detail b { color:var(--text); }
  /* architecture */
  .arch { display:grid; grid-template-columns:1fr; gap:0.8rem; }
  .layer { display:flex; gap:1rem; align-items:center; background:var(--surface); border:1px solid var(--border); border-radius:12px; padding:0.9rem 1.2rem; }
  .layer-tag { flex:0 0 150px; font-family:var(--mono); font-size:0.75rem; font-weight:700; padding:0.5rem 0.7rem; border-radius:8px; text-align:center; color:#04201f; }
  .layer p { font-size:0.85rem; color:var(--muted); line-height:1.5; }
  @media(max-width:600px){ .layer{flex-direction:column;align-items:flex-start;} .layer-tag{flex:none;width:100%;} }
  .loop-note { margin-top:1rem; text-align:center; font-size:0.85rem; color:var(--accent); font-family:var(--mono); }
  /* charts */
  .chart-card { margin-bottom:1.5rem; }
  .chart-card h3 { font-family:var(--serif); font-size:1.25rem; margin-bottom:0.4rem; }
  .chart-card .cdesc { font-size:0.85rem; color:var(--muted); line-height:1.6; margin-bottom:1.4rem; max-width:760px; }
  .hbar-label { font-size:0.8rem; font-weight:600; margin:0.9rem 0 0.35rem; display:flex; justify-content:space-between; gap:1rem; }
  .hbar-label span:last-child { font-family:var(--mono); color:var(--accent); }
  .hbar-track { background:var(--border); border-radius:8px; height:20px; overflow:hidden; display:flex; }
  .hbar { height:100%; width:0; transition:width 1.2s ease; }
  .legend { display:flex; gap:1.2rem; flex-wrap:wrap; font-size:0.75rem; color:var(--muted); margin-bottom:0.5rem; }
  .legend i { display:inline-block; width:10px; height:10px; border-radius:3px; margin-right:0.4rem; }
  .vbars { display:flex; align-items:flex-end; justify-content:space-around; height:220px; border-bottom:1px solid var(--border); padding-top:1.5rem; }
  .vcol { display:flex; flex-direction:column; align-items:center; justify-content:flex-end; width:22%; height:100%; }
  .vbar { width:100%; border-radius:8px 8px 0 0; height:0; transition:height 1.2s ease; }
  .vval { font-family:var(--mono); font-weight:700; font-size:0.9rem; margin-bottom:0.4rem; }
  .vlabels { display:flex; justify-content:space-around; font-size:0.78rem; font-weight:600; margin-top:0.6rem; text-align:center; }
  .vlabels span { width:22%; }
  .donut-wrap { display:flex; align-items:center; gap:2rem; flex-wrap:wrap; }
  .donut { width:150px; height:150px; border-radius:50%; position:relative; flex:none; }
  .donut::after { content:attr(data-center); position:absolute; inset:24px; background:var(--card); border-radius:50%; display:flex; align-items:center; justify-content:center; font-family:var(--mono); font-weight:700; font-size:0.8rem; text-align:center; }
  .two-col { display:grid; grid-template-columns:1fr 1fr; gap:1.5rem; }
  @media(max-width:800px){ .two-col{grid-template-columns:1fr;} }
  .facts { display:flex; gap:0.8rem; flex-wrap:wrap; margin-top:1rem; }
  .fact { background:var(--surface); border:1px solid var(--border); border-radius:10px; padding:0.6rem 1rem; font-size:0.78rem; color:var(--muted); }
  .fact b { color:var(--text); font-family:var(--mono); font-size:1rem; display:block; }
  .lib-title { font-family:var(--mono); font-size:0.72rem; color:var(--accent); margin:1rem 0 0.5rem; letter-spacing:1px; }
  .chips { display:flex; flex-wrap:wrap; gap:0.45rem; }
  .chip { background:var(--surface); border:1px solid var(--border); color:var(--text); font-family:var(--sans); font-size:0.78rem; padding:0.3rem 0.7rem; border-radius:20px; cursor:pointer; transition:all 0.2s; }
  .chip:hover { border-color:var(--accent); color:var(--accent); }
  .lim-list p b { color:var(--text); }
  .refs { font-size:0.8rem; color:var(--muted); line-height:1.7; padding-left:1.2rem; }
  .refs li { margin-bottom:0.5rem; }
  .credit { position:relative; z-index:1; text-align:center; padding:1rem 1rem 3rem; font-family:var(--mono); font-size:0.72rem; color:var(--muted); line-height:1.8; }
  .credit a { color:var(--accent); text-decoration:none; }
</style>
</head>
