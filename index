const kb = [
  [/alphafold|protein.*(fold|structure)|plddt|casp/, 'AlphaFold is a neural network that predicts a protein\'s 3D structure from its amino acid sequence. In the CASP14 test its median backbone error was 0.96 Å versus 2.8 Å for the next best method, and it gives pLDDT confidence scores so users know which regions to trust [7].'],
  [/virtual screening|screen|halicin|antibiotic|107/, 'Virtual screening uses a computer to rank a very large number of molecules. Stokes et al. trained a neural network on 2,335 molecules, applied it to libraries of more than 107 million, and tested 23 predictions in the lab; 8 were antibacterial. Halicin was found in the Drug Repurposing Hub [6].'],
  [/de novo|generative|gentrl|ddr1|21 days/, 'De novo design means asking a model to create new molecules from scratch. Zhavoronkov et al. used the generative model GENTRL to design DDR1 kinase inhibitors in 21 days, with 46 days from design to validation [5].'],
  [/phase|clinical|success|trial/, 'Jayatunga et al. report 80–90% Phase I success for AI-discovered molecules (historic industry range about 40–65%), but about 40% in Phase II on a limited sample — similar to historic averages. So early success does not yet clearly continue into efficacy trials [8].'],
  [/limit|bias|challenge|problem|weak/, 'Main limits: biased or narrow training data, human bias, small Phase II samples, and models that cannot yet fully predict how a drug behaves in the human body. That is why lab and clinical validation are still needed [4], [8].'],
  [/cost|time|expensive|years|billion/, 'One survey states a new drug costs about $2.6 billion on average and can take more than 10 years, with many candidates failing along the way. Removing weak candidates early with AI can save time and cost [2].'],
  [/pipeline|stage|workflow|where/, 'The pipeline has six stages: target identification, hit finding (virtual screening), lead design (de novo), synthesis planning, preclinical tests and clinical trials. AI can help at every stage — see the Pipeline section above.'],
  [/repurpos/, 'Drug repurposing finds new uses for existing drugs. In the antibiotic study, halicin was found as an antibacterial compound in the Drug Repurposing Hub [6].'],
  [/replace|lab|wet/, 'AI does not replace the laboratory. It helps choose which experiments are worth doing first; predictions must still be checked in lab experiments, animal studies and clinical trials.'],
  [/adm|toxic/, 'ADMET stands for Absorption, Distribution, Metabolism, Excretion and Toxicity. AI models predict these properties early so weak candidates are removed before preclinical tests — try the ADMET Predictor above.']
];
function localAnswer(q){
  q = q.toLowerCase();
  for(const [re,ans] of kb) if(re.test(q)) return ans;
  return 'Good question! I can answer about the pipeline, AlphaFold, virtual screening, de novo design, clinical success rates, costs, ADMET or limitations. Try one of those topics.';
}
let chatHistory = [];
function addMsg(role, text){
  const wrap = document.getElementById('chat-messages');
  const div = document.createElement('div'); div.className='msg';
  const isAI = role==='assistant';
  div.innerHTML=`<div class="msg-avatar ${isAI?'ai':'user'}">${isAI?'AI':'U'}</div><div class="msg-bubble ${isAI?'ai-bubble':''}">${text.replace(/</g,'&lt;').replace(/>/g,'&gt;')}</div>`;
  wrap.appendChild(div); wrap.scrollTop=wrap.scrollHeight; return div;
}
function addTyping(){
  const wrap = document.getElementById('chat-messages');
  const div = document.createElement('div'); div.className='msg'; div.id='typing-indicator';
  div.innerHTML=`<div class="msg-avatar ai">AI</div><div class="msg-bubble ai-bubble"><div class="typing"><span></span><span></span><span></span></div></div>`;
  wrap.appendChild(div); wrap.scrollTop=wrap.scrollHeight;
}
async function sendChat(){
  const inp = document.getElementById('chat-input');
  const text = inp.value.trim(); if(!text) return;
  inp.value=''; inp.style.height='auto';
  const btn = document.getElementById('chat-btn'); btn.disabled=true;
  addMsg('user',text); chatHistory.push({role:'user',content:text}); addTyping();
  let reply;
  try{
    const resp = await fetch('https://api.anthropic.com/v1/messages',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({
      model:'claude-sonnet-4-6',max_tokens:1000,
      system:`You are an assistant for a first-year B.Tech student project "Artificial Intelligence in Drug Discovery" (Biology for Engineers). Explain in simple, student-friendly language. Cover: AI in the drug pipeline, AlphaFold, virtual screening, de novo design, drug repurposing, clinical trial success rates of AI-discovered molecules, ADMET, and limitations like biased data. Keep answers short.`,
      messages:chatHistory})});
    const data = await resp.json();
    reply = data.content.map(i=>i.text||'').join('');
    if(!reply) throw new Error('empty');
  } catch(err){ reply = localAnswer(text); }
  document.getElementById('typing-indicator')?.remove();
  addMsg('assistant',reply); chatHistory.push({role:'assistant',content:reply});
  btn.disabled=false;
}


