const admetLocal = {}, medList = [], abxList = [];
function mkEntry(r){
  const [name,alias,formula,mw,cls,F,dist,metab,t,route,tox,toxS,sol,lip] = r;
  const iv = F === 'IV', fnum = iv ? 0 : parseFloat(F.match(/\d+/)[0]);
  const absLvl = iv ? 'Poor oral (given by injection)' : fnum>=80 ? 'High' : fnum>=40 ? 'Medium' : 'Low';
  const absS = iv ? 'bad' : fnum>=80 ? 'good' : fnum>=40 ? 'ok' : 'bad';
  const tt = /h|day/.test(t) ? t : t + ' h';
  const tmax = Math.max(...tt.match(/\d+(\.\d+)?/g).map(Number)) * (/day/.test(tt) ? 24 : 1);
  const tS = tmax<=12 ? 'good' : tmax<=72 ? 'ok' : 'bad';
  const mS = /induces|inhibits/.test(metab) ? 'bad' : /CYP/.test(metab) ? 'ok' : 'good';
  const dS = /accumulates|Large Vd/.test(dist) ? 'ok' : 'good';
  const sS = /^Very low/.test(sol) ? 'bad' : /^Low/.test(sol) ? 'ok' : 'good';
  const lS = lip.startsWith('Pass') ? 'good' : lip.startsWith('Borderline') ? 'ok' : 'bad';
  const reason = (lip.match(/\((.*)\)/)||['',''])[1];
  const summary = `${name} (${cls}). ` +
    (iv ? 'It is given by injection because oral absorption is poor. ' : `Oral absorption is ${absLvl.toLowerCase()}. `) +
    `Main concern: ${tox}. ` +
    (lS==='good' ? "It passes Lipinski's rule of five." : `It breaks Lipinski's rule of five (${reason || 'borderline'}), yet still works as a drug, because the rules are a guide, not a law.`);
  return {molecule:name, formula:sub(formula), mw, cls, summary, properties:[
    ['🫀','ABSORPTION',absLvl,absS], ['🩸','DISTRIBUTION',dist,dS], ['⚙️','METABOLISM',metab,mS],
    ['🚽','EXCRETION',`t½ ≈ ${tt}, ${route}`,tS], ['☠️','TOXICITY',tox,toxS], ['💧','SOLUBILITY',sol,sS],
    ['🧬','BIOAVAILABILITY', iv ? 'Not an oral drug' : `≈ ${F}%`, absS], ['📏','LIPINSKI Ro5',lip,lS]]};
}
function register(rows, list){
  rows.forEach(r=>{
    const e = mkEntry(r); list.push(r[0]);
    [r[0], ...r[1].split(',')].map(s=>s.trim().toLowerCase()).filter(Boolean).forEach(k=>admetLocal[k]=e);
  });
}
register(medRows, medList); register(abxRows, abxList);
function findLocal(q){
  const k = q.trim().toLowerCase();
  if(admetLocal[k]) return admetLocal[k];
  if(k.length>=3){ const m = Object.keys(admetLocal).find(n=>n.startsWith(k)); if(m) return admetLocal[m]; }
  return null;
}
(function buildLibrary(){
  const dl = document.createElement('datalist'); dl.id='drug-list';
  dl.innerHTML = [...medList,...abxList].map(n=>`<option value="${n}">`).join('');
  document.body.appendChild(dl);
  const mk = (id,list)=>{ document.getElementById(id).innerHTML = list.slice().sort().map(n=>`<button class="chip" onclick="pickDrug('${n}')">${n}</button>`).join(''); };
  mk('chips-meds',medList); mk('chips-abx',abxList);
  document.getElementById('cnt-meds').textContent = medList.length;
  document.getElementById('cnt-abx').textContent = abxList.length;
})();
function pickDrug(n){
  document.getElementById('admet-input').value = n;
  document.getElementById('admet-input').scrollIntoView({behavior:'smooth',block:'center'});
  runADMET();
}

function renderADMET(p){
  const colorMap = {good:'var(--accent3)',ok:'var(--warn)',bad:'#f87171'};
  document.getElementById('admet-cards').innerHTML = p.properties.map(x=>{
    const [icon,name,value,status] = Array.isArray(x)?x:[x.icon,x.name,x.value,x.status];
    return `<div class="admet-card"><div class="admet-icon">${icon}</div><div class="admet-name">${name}</div><div class="admet-val" style="color:${colorMap[status]||'var(--text)'}">${value}</div></div>`;
  }).join('');
  document.getElementById('admet-summary').innerHTML = `<b style="color:var(--text)">${p.molecule}</b> &nbsp;·&nbsp; <span style="font-family:var(--mono);color:var(--accent)">${p.formula}</span> &nbsp;·&nbsp; MW: ${p.mw}${p.cls?' &nbsp;·&nbsp; '+p.cls:''}<br/><br/>${p.summary}`;
}
async function runADMET(){
  const mol = document.getElementById('admet-input').value.trim();
  if(!mol) return;
  const btn = document.getElementById('admet-btn');
  btn.disabled = true; btn.innerHTML = '<span class="spinner"></span> Predicting...';
  document.getElementById('admet-result').classList.add('show');
  document.getElementById('admet-cards').innerHTML = '<div style="color:var(--muted);font-size:0.85rem;padding:0.5rem 0">⏳ Analyzing molecule...</div>';
  document.getElementById('admet-summary').textContent = '';
  const local = findLocal(mol);
  if(local){ renderADMET(local); btn.disabled=false; btn.innerHTML='🔍 Predict ADMET'; return; }
  let done = false;
  try {
    const resp = await fetch('https://api.anthropic.com/v1/messages',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({
      model:'claude-sonnet-4-6',max_tokens:1000,
      system:`You are an ADMET prediction engine for a student project. Respond ONLY with valid JSON (no markdown). Format: {"found":true,"molecule":"name","formula":"formula","mw":"MW in Da","properties":[{"icon":"🫀","name":"ABSORPTION","value":"...","status":"good/ok/bad"},{"icon":"🩸","name":"DISTRIBUTION","value":"...","status":"..."},{"icon":"⚙️","name":"METABOLISM","value":"...","status":"..."},{"icon":"🚽","name":"EXCRETION","value":"...","status":"..."},{"icon":"☠️","name":"TOXICITY","value":"...","status":"..."},{"icon":"💧","name":"SOLUBILITY","value":"...","status":"..."},{"icon":"🧬","name":"BIOAVAILABILITY","value":"...","status":"..."},{"icon":"📏","name":"LIPINSKI Ro5","value":"Pass/Fail","status":"good/bad"}],"summary":"2-3 sentences"} If unknown return {"found":false}.`,
      messages:[{role:'user',content:`ADMET prediction for: ${mol}`}]})});
    const data = await resp.json();
    const text = data.content.map(i=>i.text||'').join('');
    const parsed = JSON.parse(text.replace(/```json|```/g,'').trim());
    if(parsed.found){ renderADMET(parsed); done = true; }
    else { document.getElementById('admet-cards').innerHTML='<div style="color:var(--warn);font-size:0.85rem;padding:0.5rem 0">⚠ Molecule not recognized. Try a common drug name like "Aspirin" or "Metformin".</div>'; done = true; }
  } catch(err){}
  if(!done){
    const k = mol.toLowerCase();
    if(admetLocal[k]) renderADMET(admetLocal[k]);
    else document.getElementById('admet-cards').innerHTML='<div style="color:var(--warn);font-size:0.85rem;padding:0.5rem 0">⚠ Not in the built-in library. Pick a drug from the Drug Library below.</div>';
  }
  btn.disabled=false; btn.innerHTML='🔍 Predict ADMET';
}

