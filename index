function scoreClass(s){
  if(s<=-8) return 'good';
  if(s<=-5.5) return 'ok';
  return 'bad';
}
function scoreLabel(s){
  if(s<=-8) return '✅ Strong';
  if(s<=-5.5) return '⚠️ Moderate';
  return '❌ Weak';
}
function pct(s){ return Math.min(100, Math.max(0, (-s/12)*100)).toFixed(0); }

function runDocking(){
  const btn = document.getElementById('dock-btn');
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner"></span> Running...';

  setTimeout(()=>{
    const lig = document.getElementById('ligand-select').value;
    const rec = document.getElementById('receptor-select').value;
    const d = dockingData[lig][rec];
    const sc = scoreClass(d.score);
    const pctVal = pct(d.score);
    const colors = {good:'#10b981',ok:'#f59e0b',bad:'#f87171'};

    document.getElementById('dock-metrics').innerHTML = `
      <div class="metric-row">
        <span class="metric-label">Predicted Binding Energy (ΔG)</span>
        <span class="metric-value ${sc}">${d.score} kcal/mol — ${scoreLabel(d.score)}</span>
      </div>
      <div class="score-bar-wrap">
        <div class="score-bar-bg">
          <div class="score-bar-fill" style="width:0;background:${colors[sc]}" data-w="${pctVal}"></div>
        </div>
      </div>
      <div class="metric-row">
        <span class="metric-label">Hydrogen Bonds Formed</span>
        <span class="metric-value" style="color:var(--accent)">${d.hb}</span>
      </div>
      <div class="metric-row">
        <span class="metric-label">Van der Waals Interaction</span>
        <span class="metric-value" style="color:var(--accent2)">${d.vdw} kcal/mol</span>
      </div>
      <div class="metric-row">
        <span class="metric-label">Electrostatic Energy</span>
        <span class="metric-value" style="color:var(--accent3)">${d.elec} kcal/mol</span>
      </div>
      <div class="metric-row">
        <span class="metric-label">Lipinski Rule of Five</span>
        <span class="metric-value ${d.lip?'good':'bad'}">${d.lip?'✅ PASS':'❌ FAIL (may have bioavailability issues)'}</span>
      </div>
      <div style="margin-top:1rem;padding:0.8rem 1rem;background:rgba(0,212,255,0.05);border:1px solid rgba(0,212,255,0.15);border-radius:8px;font-size:0.8rem;color:var(--muted);line-height:1.6;">
        <b style="color:var(--text)">Interpretation:</b> A ΔG of <b>${d.score} kcal/mol</b> indicates 
        ${d.score<=-8?'strong, promising binding — worth advancing to ADMET analysis and lab testing.':d.score<=-5.5?'moderate binding — may be optimized with structural modifications.':'weak binding — this molecule is unlikely to inhibit this target effectively.'}
      </div>
    `;

    const panel = document.getElementById('dock-result');
    panel.classList.add('show');
    // animate bar
    setTimeout(()=>{
      const bar = panel.querySelector('.score-bar-fill');
      if(bar) bar.style.width = bar.dataset.w + '%';
    },100);

    btn.disabled = false;
    btn.innerHTML = '▶ Run Screening';
  }, 1400);
}


